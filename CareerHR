<!doctype html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="เว็บไซต์ประกาศรับสมัครงาน">
  <title>ร่วมงานกับเรา</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="#" aria-label="หน้าแรก">
      <span class="brand-mark">HR</span>
      <span class="brand-text">
        <strong>CAREERS</strong>
        <small>ร่วมเติบโตไปกับเรา</small>
      </span>
    </a>

    <nav aria-label="เมนูหลัก">
      <a href="#jobs">ตำแหน่งงาน</a>
      <a href="#about">เกี่ยวกับเรา</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div class="hero-content">
        <span class="eyebrow">WE ARE HIRING</span>
        <h1>โอกาสใหม่ของคุณ<br><span>เริ่มต้นที่นี่</span></h1>
        <p>ค้นหาตำแหน่งที่เหมาะกับคุณ และเข้ามาเป็นส่วนหนึ่งของทีมที่พร้อมเติบโตไปด้วยกัน</p>
        <a class="primary-button" href="#jobs">ดูตำแหน่งที่เปิดรับ</a>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="art-card art-card-one">
          <span class="art-icon">01</span>
          <span>ค้นหางานที่ใช่</span>
        </div>
        <div class="art-card art-card-two">
          <span class="art-icon">02</span>
          <span>ส่งใบสมัคร</span>
        </div>
        <div class="art-card art-card-three">
          <span class="art-icon">03</span>
          <span>เติบโตไปด้วยกัน</span>
        </div>
        <div class="art-circle"></div>
      </div>
    </section>

    <section class="jobs-section" id="jobs">
      <div class="section-heading">
        <div>
          <span class="eyebrow">OPEN POSITIONS</span>
          <h2>ตำแหน่งงานที่เปิดรับ</h2>
        </div>
        <p>คลิกที่ตำแหน่งงานเพื่อเปิดหน้าใบสมัคร</p>
      </div>

      <div class="job-grid" id="job-list" aria-live="polite"></div>
    </section>

    <section class="about-section" id="about">
      <span class="eyebrow">WHY JOIN US</span>
      <h2>มาร่วมสร้างผลงานที่มีความหมาย</h2>
      <p>เราให้ความสำคัญกับการทำงานเป็นทีม การเรียนรู้ และโอกาสในการพัฒนาของทุกคน</p>
      <div class="benefit-grid">
        <article>
          <strong>ทีมที่พร้อมสนับสนุน</strong>
          <p>ทำงานร่วมกับทีมที่เปิดรับความคิดเห็นและช่วยกันแก้ปัญหา</p>
        </article>
        <article>
          <strong>โอกาสเติบโต</strong>
          <p>เรียนรู้ทักษะใหม่และพัฒนาความสามารถอย่างต่อเนื่อง</p>
        </article>
        <article>
          <strong>สภาพแวดล้อมที่ดี</strong>
          <p>พื้นที่ทำงานที่ให้ความสำคัญกับผู้คนและผลงาน</p>
        </article>
      </div>
    </section>
  </main>

  <footer>
    <span>© <span id="current-year"></span> Careers. All rights reserved.</span>
    <span>ติดต่อฝ่ายทรัพยากรบุคคล: hr@example.com</span>
  </footer>

  <script src="script.js"></script>
</body>
</html>
:root {
  --navy: #08254f;
  --blue: #0b67d1;
  --blue-light: #eaf4ff;
  --cyan: #39bdf8;
  --white: #ffffff;
  --text: #17304f;
  --muted: #64748b;
  --line: #dce8f5;
  --shadow: 0 18px 50px rgba(8, 37, 79, 0.12);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  color: var(--text);
  background: #f8fbff;
  font-family: "Prompt", system-ui, sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

.site-header {
  position: sticky;
  z-index: 20;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76px;
  padding: 12px clamp(24px, 6vw, 96px);
  border-bottom: 1px solid rgba(220, 232, 245, 0.8);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(14px);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  display: grid;
  width: 46px;
  height: 46px;
  place-items: center;
  border-radius: 14px;
  color: var(--white);
  background: linear-gradient(135deg, var(--blue), var(--cyan));
  font-weight: 700;
  letter-spacing: 0.04em;
  box-shadow: 0 8px 22px rgba(11, 103, 209, 0.28);
}

.brand-text {
  display: grid;
  line-height: 1.15;
}

.brand-text strong {
  color: var(--navy);
  letter-spacing: 0.1em;
}

.brand-text small {
  margin-top: 5px;
  color: var(--muted);
  font-size: 11px;
}

nav {
  display: flex;
  gap: 32px;
  color: #425a76;
  font-size: 14px;
  font-weight: 500;
}

nav a:hover {
  color: var(--blue);
}

.hero {
  position: relative;
  display: grid;
  min-height: 610px;
  padding: 95px clamp(24px, 8vw, 130px);
  overflow: hidden;
  grid-template-columns: 1.05fr 0.95fr;
  align-items: center;
  background:
    radial-gradient(circle at 90% 10%, rgba(57, 189, 248, 0.23), transparent 26%),
    linear-gradient(135deg, #f7fbff 0%, #eaf4ff 100%);
}

.hero::before {
  position: absolute;
  bottom: -180px;
  left: -140px;
  width: 420px;
  height: 420px;
  border: 1px solid rgba(11, 103, 209, 0.12);
  border-radius: 50%;
  content: "";
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 680px;
}

.eyebrow {
  display: inline-block;
  margin-bottom: 14px;
  color: var(--blue);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.18em;
}

h1,
h2,
p {
  margin-top: 0;
}

h1 {
  margin-bottom: 24px;
  color: var(--navy);
  font-size: clamp(48px, 6vw, 82px);
  line-height: 1.13;
  letter-spacing: -0.035em;
}

h1 span {
  color: var(--blue);
}

.hero-content p {
  max-width: 580px;
  margin-bottom: 32px;
  color: #526a85;
  font-size: 17px;
  font-weight: 300;
  line-height: 1.9;
}

.primary-button {
  display: inline-flex;
  min-height: 52px;
  padding: 0 28px;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  color: var(--white);
  background: var(--blue);
  font-size: 14px;
  font-weight: 600;
  box-shadow: 0 12px 28px rgba(11, 103, 209, 0.25);
  transition: transform 160ms ease, box-shadow 160ms ease;
}

.primary-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 16px 34px rgba(11, 103, 209, 0.32);
}

.hero-art {
  position: relative;
  min-height: 380px;
}

.art-circle {
  position: absolute;
  top: 50%;
  left: 54%;
  width: 330px;
  height: 330px;
  border: 68px solid rgba(11, 103, 209, 0.09);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.art-card {
  position: absolute;
  z-index: 2;
  display: grid;
  width: 225px;
  min-height: 100px;
  padding: 20px;
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: var(--shadow);
  backdrop-filter: blur(12px);
  grid-template-columns: 52px 1fr;
  align-items: center;
  gap: 14px;
  font-size: 14px;
  font-weight: 500;
}

.art-icon {
  display: grid;
  width: 52px;
  height: 52px;
  place-items: center;
  border-radius: 16px;
  color: var(--white);
  background: linear-gradient(135deg, var(--blue), var(--cyan));
  font-weight: 700;
}

.art-card-one {
  top: 22px;
  right: 8%;
}

.art-card-two {
  top: 144px;
  left: 3%;
}

.art-card-three {
  right: 0;
  bottom: 10px;
}

.jobs-section,
.about-section {
  padding: 100px clamp(24px, 8vw, 130px);
}

.section-heading {
  display: flex;
  margin-bottom: 40px;
  align-items: end;
  justify-content: space-between;
  gap: 24px;
}

h2 {
  margin-bottom: 0;
  color: var(--navy);
  font-size: clamp(30px, 4vw, 46px);
  line-height: 1.3;
}

.section-heading p {
  margin-bottom: 8px;
  color: var(--muted);
  font-size: 14px;
}

.job-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.job-card {
  position: relative;
  display: flex;
  min-height: 280px;
  padding: 30px;
  overflow: hidden;
  border-radius: 22px;
  color: var(--white);
  background: linear-gradient(145deg, #0875df 0%, #0757b7 100%);
  box-shadow: 0 16px 36px rgba(11, 103, 209, 0.2);
  flex-direction: column;
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.job-card::after {
  position: absolute;
  right: -55px;
  bottom: -85px;
  width: 210px;
  height: 210px;
  border: 35px solid rgba(255, 255, 255, 0.09);
  border-radius: 50%;
  content: "";
}

.job-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 24px 46px rgba(11, 103, 209, 0.28);
}

.job-type {
  align-self: flex-start;
  padding: 7px 12px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.13);
  font-size: 11px;
}

.job-card h3 {
  margin: 24px 0 8px;
  font-size: 25px;
  line-height: 1.4;
}

.job-card p {
  margin-bottom: 24px;
  color: rgba(255, 255, 255, 0.78);
  font-size: 13px;
}

.job-link {
  position: relative;
  z-index: 2;
  display: flex;
  margin-top: auto;
  align-items: center;
  justify-content: space-between;
  font-size: 14px;
  font-weight: 600;
}

.job-arrow {
  display: grid;
  width: 40px;
  height: 40px;
  place-items: center;
  border-radius: 50%;
  color: var(--blue);
  background: var(--white);
  font-size: 20px;
}

.about-section {
  color: var(--white);
  background: var(--navy);
  text-align: center;
}

.about-section h2 {
  color: var(--white);
}

.about-section > p {
  max-width: 650px;
  margin: 18px auto 44px;
  color: #b9cbe0;
  line-height: 1.8;
}

.benefit-grid {
  display: grid;
  max-width: 1050px;
  margin: 0 auto;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.benefit-grid article {
  padding: 28px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.05);
  text-align: left;
}

.benefit-grid strong {
  display: block;
  margin-bottom: 10px;
  font-size: 17px;
}

.benefit-grid p {
  margin-bottom: 0;
  color: #a9bdd4;
  font-size: 13px;
  line-height: 1.8;
}

footer {
  display: flex;
  min-height: 88px;
  padding: 24px clamp(24px, 8vw, 130px);
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  color: var(--muted);
  background: var(--white);
  font-size: 12px;
}

@media (max-width: 920px) {
  .hero {
    grid-template-columns: 1fr;
  }

  .hero-art {
    margin-top: 50px;
  }

  .job-grid,
  .benefit-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 640px) {
  .site-header {
    min-height: 68px;
  }

  nav {
    display: none;
  }

  .hero {
    min-height: auto;
    padding-top: 70px;
    padding-bottom: 70px;
  }

  h1 {
    font-size: 47px;
  }

  .hero-art {
    display: none;
  }

  .jobs-section,
  .about-section {
    padding-top: 70px;
    padding-bottom: 70px;
  }

  .section-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .job-grid,
  .benefit-grid {
    grid-template-columns: 1fr;
  }

  .job-card {
    min-height: 250px;
  }

  footer {
    align-items: flex-start;
    flex-direction: column;
  }
}
// แก้ไขรายการงานและ URL ปลายทางได้ที่นี่
const jobs = [
  {
    title: "เจ้าหน้าที่ธุรการ",
    department: "ฝ่ายสนับสนุนองค์กร",
    location: "กรุงเทพมหานคร",
    type: "งานประจำ",
    applicationUrl: "./application.html?position=เจ้าหน้าที่ธุรการ",
  },
  {
    title: "เจ้าหน้าที่ประสานงาน",
    department: "ฝ่ายปฏิบัติการ",
    location: "กรุงเทพมหานคร",
    type: "งานประจำ",
    applicationUrl: "./application.html?position=เจ้าหน้าที่ประสานงาน",
  },
  {
    title: "พนักงานบริการลูกค้า",
    department: "ฝ่ายลูกค้าสัมพันธ์",
    location: "กรุงเทพมหานคร",
    type: "งานประจำ",
    applicationUrl: "./application.html?position=พนักงานบริการลูกค้า",
  },
];

const jobList = document.querySelector("#job-list");

jobs.forEach((job) => {
  const link = document.createElement("a");
  link.className = "job-card";
  link.href = job.applicationUrl;
  link.target = "_blank";
  link.rel = "noopener noreferrer";
  link.setAttribute("aria-label", `สมัครตำแหน่ง ${job.title}`);

  link.innerHTML = `
    <span class="job-type">${job.type}</span>
    <h3>${job.title}</h3>
    <p>${job.department}<br>${job.location}</p>
    <span class="job-link">
      ดูรายละเอียดและสมัคร
      <span class="job-arrow" aria-hidden="true">→</span>
    </span>
  `;

  jobList.appendChild(link);
});

document.querySelector("#current-year").textContent = new Date().getFullYear();
<!doctype html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>แบบฟอร์มสมัครงาน</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="application.css">
</head>
<body>
  <main class="application-card">
    <a class="back-link" href="./index.html">← กลับหน้าตำแหน่งงาน</a>
    <span class="tag">APPLICATION</span>
    <h1>สมัครงานกับเรา</h1>
    <p class="position">ตำแหน่ง: <strong id="position-name">ตำแหน่งที่สนใจ</strong></p>

    <div class="notice">
      <strong>หน้าตัวอย่าง</strong>
      <p>หน้านี้เป็นหน้าปลายทางชั่วคราว เมื่อมี URL แบบฟอร์มจริงแล้วสามารถนำมาเปลี่ยนได้ทันที</p>
    </div>

    <form id="demo-form">
      <label>
        ชื่อ-นามสกุล
        <input type="text" placeholder="กรอกชื่อและนามสกุล" required>
      </label>
      <label>
        อีเมล
        <input type="email" placeholder="name@example.com" required>
      </label>
      <label>
        เบอร์โทรศัพท์
        <input type="tel" placeholder="08x-xxx-xxxx" required>
      </label>
      <button type="submit">ส่งใบสมัครตัวอย่าง</button>
    </form>

    <p class="form-message" id="form-message" role="status"></p>
  </main>

  <script>
    const params = new URLSearchParams(window.location.search);
    const position = params.get("position");
    if (position) {
      document.querySelector("#position-name").textContent = position;
    }

    document.querySelector("#demo-form").addEventListener("submit", (event) => {
      event.preventDefault();
      document.querySelector("#form-message").textContent =
        "นี่เป็นแบบฟอร์มตัวอย่าง จึงยังไม่มีการส่งหรือบันทึกข้อมูล";
    });
  </script>
</body>
</html>
:root {
  --navy: #08254f;
  --blue: #0b67d1;
  --line: #dce8f5;
  --muted: #64748b;
}

* {
  box-sizing: border-box;
}

body {
  display: grid;
  min-height: 100vh;
  margin: 0;
  padding: 40px 20px;
  place-items: center;
  color: #17304f;
  background:
    radial-gradient(circle at 90% 10%, rgba(57, 189, 248, 0.25), transparent 30%),
    #eef6ff;
  font-family: "Prompt", system-ui, sans-serif;
}

.application-card {
  width: min(100%, 620px);
  padding: clamp(28px, 6vw, 54px);
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: 26px;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 24px 70px rgba(8, 37, 79, 0.14);
}

.back-link {
  display: inline-block;
  margin-bottom: 38px;
  color: var(--blue);
  text-decoration: none;
  font-size: 13px;
  font-weight: 500;
}

.tag {
  display: block;
  margin-bottom: 8px;
  color: var(--blue);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.18em;
}

h1 {
  margin: 0 0 8px;
  color: var(--navy);
  font-size: clamp(34px, 7vw, 50px);
}

.position {
  margin: 0 0 28px;
  color: var(--muted);
}

.notice {
  margin-bottom: 28px;
  padding: 18px 20px;
  border-left: 4px solid var(--blue);
  border-radius: 10px;
  background: #eaf4ff;
  font-size: 13px;
}

.notice p {
  margin: 6px 0 0;
  color: var(--muted);
  line-height: 1.7;
}

form {
  display: grid;
  gap: 18px;
}

label {
  display: grid;
  gap: 7px;
  color: var(--navy);
  font-size: 13px;
  font-weight: 500;
}

input {
  min-height: 48px;
  padding: 0 14px;
  border: 1px solid var(--line);
  border-radius: 10px;
  outline: none;
  font: inherit;
}

input:focus {
  border-color: var(--blue);
  box-shadow: 0 0 0 3px rgba(11, 103, 209, 0.1);
}

button {
  min-height: 50px;
  margin-top: 8px;
  border: 0;
  border-radius: 11px;
  color: white;
  background: var(--blue);
  cursor: pointer;
  font: inherit;
  font-weight: 600;
}

button:hover {
  background: #095bb9;
}

.form-message {
  margin: 18px 0 0;
  color: var(--blue);
  font-size: 13px;
  line-height: 1.6;
}
